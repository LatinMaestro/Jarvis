# Required secrets - add real values in Railway Variables, not in GitHub
DISCORD_BOT_TOKEN=
MR_API_KEY=

# SQLite persistent volume setup
MR_DB_PATH=/data/marvel_rivals_stats.db
MR_DB_SEED_PATH=marvel_rivals_stats.db

# Import behaviour
AUTO_IMPORT_MAX_HISTORY_PAGES=2
AUTO_IMPORT_MAX_LOOKBACK_DAYS=4
AUTO_IMPORT_FIRST_RUN_LOOKBACK_DAYS=7
AUTO_IMPORT_REFRESH_ROSTER_DEFAULT=false
HERO_NAME_API_FALLBACK_ENABLED=false
ENABLE_COMMAND_HERO_CACHE_REFRESH=false
ENABLE_WEB_MONITOR=false
ENABLE_KEEP_ALIVE=false

# Discord-native @Jarvis AI assistant (Gemini free tier only)
AI_ASSISTANT_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
AI_ASSISTANT_FREE_ONLY=true
AI_ASSISTANT_ALLOWED_CHANNEL_IDS=
AI_ASSISTANT_DENIED_CHANNEL_IDS=
AI_ASSISTANT_MAX_CONTEXT_ROWS=100
AI_ASSISTANT_MAX_RESPONSE_CHARS=1800
AI_ASSISTANT_COOLDOWN_SECONDS=10
AI_ASSISTANT_LOGGING_ENABLED=true
AI_ASSISTANT_DAILY_SOFT_LIMIT=
AI_ASSISTANT_MONTHLY_SOFT_LIMIT=
